# Export these variables in your shell. Go does not automatically load this file.
PORT=3000
# 127.0.0.1 keeps Bigflix on this computer. Use 0.0.0.0 for home-LAN or Docker access.
BIND_ADDR=0.0.0.0
# Access lock token required by all ConnectRPC endpoints and media streams.
AUTH_TOKEN=bigflix
# Startup default; 0 selects a dynamic port. Saved admin settings take precedence.
TORRENT_LISTEN_PORT=51413
DATA_DIR=./data
YTS_API_URL=https://movies-api.accel.li/api/v2/
# TMDB API Read Access Token (Bearer token, not the v3 API key)
TMDB_READ_TOKEN=
# Torrent byte cache and space limits (decimal GB)
MEDIA_DIR=./media/torrents
MEDIA_BUDGET_GB=50
MIN_FREE_GB=10
