# Export these variables in your shell or use with docker-compose.yml. Go does not automatically load .env.
PORT=3000
# 127.0.0.1 keeps Bigflix on this computer. Use 0.0.0.0 for home-LAN or Docker/VPS access.
BIND_ADDR=0.0.0.0
# Access lock token required by all ConnectRPC endpoints and media streams.
AUTH_TOKEN=bigflix
# Startup default; 0 selects a dynamic port. Saved admin settings take precedence.
TORRENT_LISTEN_PORT=51413
DATA_DIR=./data

# TMDB API Read Access Token (Bearer token, not the v3 API key). Also editable in Settings UI.
TMDB_READ_TOKEN=

# Torrent byte cache and space limits (decimal GB). Un-kept items auto-evict LRU by default.
MEDIA_DIR=./media/torrents
MEDIA_BUDGET_GB=50
MIN_FREE_GB=10

# FFmpeg CPU budget (2 is ideal on a 4 vCPU VPS alongside llama-server)
FFMPEG_THREADS=2

# Built-in torrent indexer mirror URLs (all toggles & URLs are also editable in Settings UI)
YTS_API_URL=https://movies-api.accel.li/api/v2/
EZTV_API_URL=https://eztvx.to/api/get-torrents
KNABEN_API_URL=https://api.knaben.org/v1
APIBAY_API_URL=https://apibay.org
NYAA_API_URL=https://nyaa.si

# Optional custom Torznab endpoint (e.g. Prowlarr / Jackett / private tracker)
TORZNAB_URL=
TORZNAB_API_KEY=

# Optional local CPU AI classifier (OpenAI-compatible /v1 endpoint: llama-server or Ollama)
# Leave blank to use the fast <1ms deterministic Go ranker only.
AI_API_URL=
AI_MODEL=Qwen3.5-0.8B
AI_API_KEY=
AI_TIMEOUT_SEC=30

# Optional online TV & movie subtitle API keys (embedded MKV, bundled torrent subs, upload & YIFY work without keys)
SUBDL_API_KEY=
OPENSUBTITLES_API_KEY=

# Development only: proxy frontend routes to Vite dev server (unset in production to serve embedded SPA).
# FRONTEND_URL=http://127.0.0.1:5173
